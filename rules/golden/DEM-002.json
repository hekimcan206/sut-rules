      "expect": []
    },
    {
      "name": "born on 29 February: 18 on 1 March",
      "patch": {
        "patient": { "birthDate": "2008-02-29" },
        "invoiceDate": "2026-03-10",
        "provision": { "admissionDate": "2026-02-28" },
        "lines": [ { "lineNo": 1, "sutCode": "900103", "serviceDate": "2026-03-01", "quantity": 1, "unitPrice": 135.00, "doctorRegistrationNo": "100001" } ] },
      "expect": [ { "line": 1, "severity": "Error", "expected": "-17", "actual": "18" } ]
    },
    {
      "name": "mammography screening age is 35 in 2025",
      "patch": {
        "patient": { "birthDate": "1988-01-01" },
