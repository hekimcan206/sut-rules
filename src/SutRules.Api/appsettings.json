{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Rules": {
    "Directory": "rules",
    "PollInterval": "00:00:02",
    "MaxInvoicesPerRequest": 5000
  },
  "OpenApi": {
    "Enabled": false
  }
}
